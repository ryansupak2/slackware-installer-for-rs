# LOCAL PATCH — slackware-installer-for-rs
#
# Independently adjustable UI font sizes for the URL bar and the tab strip.
#
# Upstream ties both to one source font: the omnibox asks for a 14pt target
# (CONTEXT_OMNIBOX_PRIMARY, height-clamped by LocationBarView), while tab
# titles are plain views::Label text (CONTEXT_LABEL, 12pt target) shared with
# every other label in the browser. Neither is exposed as a pref, a flag or a
# switch, so a rebuild is the only way to decouple them.
#
# This patch adds a dedicated CONTEXT_TAB_TITLE, has TabTitle use it, and makes
# ChromeTypographyProvider add a runtime point-delta to both contexts, read
# once per process from /etc/chromium/ui-font.conf:
#
#     omnibox_delta=N       # added to the URL bar size   (target 14pt)
#     tab_delta=N           # added to the tab strip size (target 12pt)
#
# With no config file both deltas are 0 and behaviour is identical to stock
# Chromium. Written against Chromium 157.0.8103.38.
#
# Apply from the Chromium source root:  git apply -p1 <this file>
# Background, invariants and the version-bump procedure: patches/chromium/README.md
#
--- a/ui/views/style/typography.h
+++ b/ui/views/style/typography.h
@@ -56,6 +56,14 @@
   // Text for the menu items that appear in the touch-selection context menu.
   CONTEXT_TOUCH_MENU,
 
+  // LOCAL PATCH (slackware-installer-for-rs): text on tab strip labels.
+  // ChromeTypographyProvider maps this context to Chromium's default target
+  // size plus the runtime delta from /etc/chromium/ui-font.conf, so the tab
+  // strip font can be sized independently of the URL bar. See
+  // patches/chromium/README.md. Upstream has no tab-specific context: tab
+  // titles are plain LABEL text, which is why they track every other label.
+  CONTEXT_TAB_TITLE,
+
   // Embedders must start TextContext enum values from this value.
   VIEWS_TEXT_CONTEXT_END,
 
--- a/chrome/browser/ui/views/chrome_typography.h
+++ b/chrome/browser/ui/views/chrome_typography.h
@@ -107,4 +107,21 @@
                            int style,
                            ui::ResourceBundle::FontDetails& details);
 
+// LOCAL PATCH (slackware-installer-for-rs): point deltas applied on top of
+// Chromium's built-in target sizes, so the URL bar and the tab strip can be
+// sized independently. Values come from /etc/chromium/ui-font.conf (override
+// the path with CHROMIUM_UI_FONT_CONF), are clamped to sane limits and are
+// read once per process. Defined in chrome_typography.cc. Defaults are 0, so
+// an unpatched config file means stock Chromium behaviour.
+// See patches/chromium/README.md and scripts/chromium-ui-font.sh.
+namespace chrome_ui_font {
+
+// Extra points added to the URL bar / omnibox text size (target 14pt).
+int OmniboxDelta();
+
+// Extra points added to the tab strip label size (target 12pt).
+int TabDelta();
+
+}  // namespace chrome_ui_font
+
 #endif  // CHROME_BROWSER_UI_VIEWS_CHROME_TYPOGRAPHY_H_
