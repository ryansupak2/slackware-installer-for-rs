+// LOCAL PATCH (slackware-installer-for-rs): per-element UI font deltas.
+//
+// Reads `<key>=<delta>` lines from /etc/chromium/ui-font.conf (or the path in
+// $CHROMIUM_UI_FONT_CONF). Deliberately read once per process: these deltas
+// feed the Views typography cache, so a change needs a browser restart —
+// which is what scripts/chromium-ui-font.sh tells the user to do.
+//
+// Supported keys (unknown keys are ignored, values are clamped):
+//   omnibox_delta=N   points added to URL bar text   (Chromium target: 14pt)
+//   tab_delta=N       points added to tab strip text (Chromium target: 12pt)
+//
+// Missing file, unreadable file or garbage input = 0 deltas = stock
+//
+// tests/chromium-ui-font-parse.sh extracts the block between the BEGIN/END
+// markers below and compiles it against stubs for the base:: helpers, so the
+// config parser can be tested on a machine with no Chromium tree. Keep the
+// markers, and do not put anything in the block that needs more than
+// <algorithm>/<cstdlib>/<string>/<string_view> + those four base headers.
+// BEGIN chrome-ui-font-parser
+namespace chrome_ui_font {
+
+namespace {
+
+// Wide enough to be useful with any UI font, narrow enough that a typo
+// cannot clip every tab in the strip.
+constexpr int kMinDelta = -6;
+constexpr int kMaxDelta = 10;
+
+struct Deltas {
+  int omnibox = 0;
+  int tab = 0;
+};
+
+int ClampDelta(int value) {
+  return std::clamp(value, kMinDelta, kMaxDelta);
+}
+
+Deltas LoadDeltas() {
+  Deltas deltas;
+  base::FilePath path("/etc/chromium/ui-font.conf");
+  if (const char* env_path = std::getenv("CHROMIUM_UI_FONT_CONF");
+      env_path && *env_path) {
+    path = base::FilePath(env_path);
+  }
+
+  std::string contents;
+  if (!base::ReadFileToStringWithMaxSize(path, &contents, 4096)) {
+    return deltas;
+  }
+
+  for (std::string_view raw_line :
+       base::SplitStringPiece(contents, "\n", base::TRIM_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    if (raw_line.starts_with('#')) {
+      continue;
+    }
+    const size_t equals = raw_line.find('=');
+    if (equals == std::string_view::npos) {
+      continue;
+    }
+    const std::string_view key =
+        base::TrimWhitespaceASCII(raw_line.substr(0, equals), base::TRIM_ALL);
+    int value = 0;
+    if (!base::StringToInt(
+            base::TrimWhitespaceASCII(raw_line.substr(equals + 1),
+                                      base::TRIM_ALL),
+            &value)) {
+      continue;
+    }
+    if (key == "omnibox_delta") {
+      deltas.omnibox = ClampDelta(value);
+    } else if (key == "tab_delta") {
+      deltas.tab = ClampDelta(value);
+    }
+  }
+  return deltas;
+}
+
+const Deltas& GetDeltas() {
+  // Intentionally static: one read per process, no config watching.
+  static const Deltas deltas = LoadDeltas();
+  return deltas;
+}
+
+}  // namespace
+
+int OmniboxDelta() {
+  return GetDeltas().omnibox;
+}
+
+int TabDelta() {
+  return GetDeltas().tab;
+}
+
+}  // namespace chrome_ui_font
+// END chrome-ui-font-parser
--- a/chrome/browser/ui/views/chrome_typography_provider.cc
+++ b/chrome/browser/ui/views/chrome_typography_provider.cc
@@ -141,6 +141,22 @@
     details.size_delta -= 2;
   }
 
+  // LOCAL PATCH (slackware-installer-for-rs): per-element UI font deltas.
+  // Applied last so a user override wins over Chromium's built-in target
+  // sizes. With no /etc/chromium/ui-font.conf both deltas are 0 and this is
+  // a no-op (stock behaviour). See patches/chromium/README.md.
+  switch (context) {
+    case CONTEXT_OMNIBOX_PRIMARY:
+    case CONTEXT_OMNIBOX_POPUP:
+      details.size_delta += chrome_ui_font::OmniboxDelta();
+      break;
+    case views::style::CONTEXT_TAB_TITLE:
+      details.size_delta += chrome_ui_font::TabDelta();
+      break;
+    default:
+      break;
+  }
+
   return details;
 }
 
