#!/bin/sh
# wk — web (private/kiosk): Firefox with a throwaway profile and no URL history.
#
# Differences from 'w':
#   * the profile lives in $XDG_RUNTIME_DIR (tmpfs) and is deleted on exit, so
#     nothing survives the session — no history, no cookies, no session store;
#   * --no-remote: never hands the URL to an already-running Firefox, which
#     would otherwise record it in the main profile's session store/history;
#   * permanent private browsing + history/formfill/sessionstore disabled.
#
# Usage:  wk            -> about:blank
#         wk y          -> shortcut lookup from ~/.web/shortcuts
#         wk example.com
#         wk https://example.com/whatever

uri="about:blank"
if [ $# -gt 0 ]; then
    raw="$1"
    case "$raw" in
        *://*) uri="$raw" ;;
        *)
            # Same lookup chain as w (and as the FreeBSD installer's w/wk).
            f="${HOME}/.web/shortcuts"
            [ -f "$f" ] || f="${HOME}/.surf/shortcuts"
            [ -f "$f" ] || f="/etc/web/shortcuts.default"
            [ -f "$f" ] || f="/etc/surf/shortcuts.default"
            if [ -f "$f" ]; then
                resolved=$(awk -v key="$raw" '$1 == key {print $2; exit}' "$f")
                [ -n "$resolved" ] && uri="$resolved"
            fi
            if [ "$uri" = "about:blank" ]; then
                case "$raw" in
                    *.*) uri="https://$raw" ;;
                esac
            fi
            ;;
    esac
fi

base="${XDG_RUNTIME_DIR:-/tmp}"
prof="$base/firefox-wk.$$"
mkdir -p "$prof" || exit 1
chmod 700 "$prof" 2>/dev/null || true

cat > "$prof/user.js" <<'PREFS'
user_pref("browser.privatebrowsing.autostart", true);
user_pref("places.history.enabled", false);
user_pref("browser.formfill.enable", false);
user_pref("browser.sessionstore.enabled", false);
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("browser.sessionstore.max_tabs_undo", 0);
user_pref("browser.sessionstore.max_windows_undo", 0);
user_pref("browser.startup.page", 0);
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.aboutwelcome.enabled", false);
user_pref("privacy.sanitize.sanitizeOnShutdown", true);
user_pref("privacy.clearOnShutdown.history", true);
user_pref("privacy.clearOnShutdown.formdata", true);
user_pref("privacy.clearOnShutdown.sessions", true);
user_pref("privacy.clearOnShutdown.cookies", true);
user_pref("network.cookie.lifetimePolicy", 2);
user_pref("datareporting.healthreport.uploadEnabled", false);
user_pref("datareporting.policy.dataSubmissionEnabled", false);
user_pref("toolkit.telemetry.enabled", false);
user_pref("toolkit.telemetry.unified", false);
user_pref("media.gmp-manager.updateEnabled", true);
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
PREFS

cleanup() { rm -rf "$prof"; }
trap cleanup EXIT INT TERM HUP

firefox --no-remote --profile "$prof" --private-window "$uri"
