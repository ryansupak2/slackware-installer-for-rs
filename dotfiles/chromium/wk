#!/bin/sh
# wk — Chromium, private only, no URL history preserved.
#
# Differences from 'w':
#   * --incognito: nothing is written to the normal profile's history;
#   * a throwaway --user-data-dir under $XDG_RUNTIME_DIR (tmpfs) that is deleted
#     when the browser exits, so not even the incognito session survives;
#   * no URL is handed to an already-running Chromium, so nothing can leak into
#     the normal profile's session restore;
#   * the requested page is opened at the normal profile's page zoom (125%),
#     which has to be seeded into the throwaway profile — see seed_zoom below.
#
# Usage:  wk / wk y / wk example.com / wk https://example.com/x

uri="about:blank"
if [ $# -gt 0 ]; then
    raw="$1"
    case "$raw" in
        *://*) uri="$raw" ;;
        *)
            f="${HOME}/.web/shortcuts"
            [ -f "$f" ] || f="/etc/web/shortcuts.default"
            if [ -f "$f" ]; then
                resolved=$(awk -v key="$raw" '$1 == key {print $2; exit}' "$f")
                [ -n "$resolved" ] && uri="$resolved"
            fi
            if [ "$uri" = "about:blank" ]; then
                case "$raw" in
                    *.*) uri="https://$raw" ;;
                esac
            fi
            ;;
    esac
fi

browser="/usr/local/bin/chrome"
[ -x "$browser" ] || browser=$(command -v chromium || command -v ungoogled-chromium || command -v google-chrome-stable)

SANDBOX_FLAG=""
[ "$(id -u)" -eq 0 ] && SANDBOX_FLAG="--no-sandbox"

unset GDK_DPI_SCALE

# Widevine: Chrome bundles its own CDM, so only point a Chromium build at the
# external copy. /usr/local/bin/chrome may be a symlink OR a wrapper script.
REAL_BIN=$(readlink -f "$browser" 2>/dev/null || echo "$browser")
if [ -f "$REAL_BIN" ] && grep -q '/opt/google/chrome' "$REAL_BIN" 2>/dev/null; then
    REAL_BIN=/opt/google/chrome/chrome
fi
WIDEVINE_FLAG=""
case "$REAL_BIN" in
    */google/chrome*|*google-chrome*) : ;;
    *)
        if [ -d /usr/lib64/chromium/WidevineCdm ]; then
            WV_VER=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' /usr/lib64/chromium/WidevineCdm/manifest.json 2>/dev/null)
            WIDEVINE_FLAG="--widevine-cdm-path=/usr/lib64/chromium/WidevineCdm/_platform_specific/linux_x64/libwidevinecdm.so --widevine-cdm-version=$WV_VER"
        fi
        ;;
esac

udd="${XDG_RUNTIME_DIR:-/tmp}/chromium-wk.$$"
mkdir -p "$udd" || exit 1
chmod 700 "$udd" 2>/dev/null || true
cleanup() { rm -rf "$udd"; }
trap cleanup EXIT INT TERM HUP

# Page zoom. The throwaway profile starts empty, so it does not inherit the
# normal profile's zoom and every page would open at 100%. Chrome reads zoom
# from the profile that owns the --user-data-dir, so seed it before launch.
#
# In this Chrome build only the per-host entries are honoured when rendering:
# partition.default_zoom_level alone leaves the page at 100% (verified over
# CDP: seeding it changed nothing, seeding the visited host's zoom_level
# zoomed the page, incognito included — the OTR profile inherits the regular
# profile's prefs). So copy the normal profile's partition block (its
# default_zoom_level and every per-host entry, which covers sites reached by
# clicking links) and pin the entry for the host we are about to open to that
# default_zoom_level. Sites on other hosts still open at 100% — exactly as
# they do in the normal profile, whose default_zoom_level is equally inert.
seed_zoom() {  # $1 = uri, $2 = Preferences file to write
    zoom_src="${HOME}/.config/google-chrome/Default/Preferences"
    [ -f "$zoom_src" ] || return 0
    command -v python3 >/dev/null 2>&1 || return 0
    mkdir -p "$(dirname "$2")" 2>/dev/null || return 0
    python3 - "$zoom_src" "$2" "$1" <<'PYEOF' || return 0
import json, math, sys
from urllib.parse import urlsplit

src, dst, uri = sys.argv[1:4]
host = urlsplit(uri).hostname
if not host:            # about:blank, file:// — nothing to anchor zoom to
    sys.exit(0)

try:
    part = json.load(open(src)).get("partition")
except Exception:
    part = None
if not isinstance(part, dict):
    part = {}

level = part.get("default_zoom_level")
if isinstance(level, bool) or not isinstance(level, (int, float)):
    level = math.log(1.25) / math.log(1.2)     # 125%, the installer default

per_host = part.setdefault("per_host_zoom_levels", {})
key = next(iter(per_host), "x")   # "x" is Chrome's only partition key
per_host.setdefault(key, {})[host] = {"zoom_level": level}

with open(dst, "w") as f:
    json.dump({"partition": part}, f)
PYEOF
}
seed_zoom "$uri" "$udd/Default/Preferences"

"$browser" $SANDBOX_FLAG $WIDEVINE_FLAG \
    --incognito --user-data-dir="$udd" --no-first-run \
    --force-dark-mode --enable-features=WebUIDarkMode,WebContentsDarkMode \
    "$uri"
