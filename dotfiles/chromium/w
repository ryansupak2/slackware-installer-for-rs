#!/bin/sh
# w — open a URL / shortcut in Chrome (normal profile)
#
# Shortcut file: ~/.web/shortcuts (installed from dotfiles/chromium/shortcuts.default
# by steps/web-shortcuts.sh), fallback /etc/web/shortcuts.default.
#
# Usage:  w            -> about:blank
#         w y          -> shortcut lookup
#         w example.com
#         w https://example.com/whatever

uri="about:blank"
if [ $# -gt 0 ]; then
    raw="$1"
    case "$raw" in
        *://*) uri="$raw" ;;
        *)
            f="${HOME}/.web/shortcuts"
            [ -f "$f" ] || f="/etc/web/shortcuts.default"
            if [ -f "$f" ]; then
                resolved=$(awk -v key="$raw" '$1 == key {print $2; exit}' "$f")
                [ -n "$resolved" ] && uri="$resolved"
            fi
            # If no shortcut matched and input looks like a domain/URL, add https://
            if [ "$uri" = "about:blank" ]; then
                case "$raw" in
                    *.*) uri="https://$raw" ;;
                esac
            fi
            ;;
    esac
fi

browser="/usr/local/bin/chrome"
[ -x "$browser" ] || browser=$(command -v chromium || command -v ungoogled-chromium || command -v google-chrome-stable)

# Chrome refuses to run as root without --no-sandbox (this box runs X as root).
SANDBOX_FLAG=""
[ "$(id -u)" -eq 0 ] && SANDBOX_FLAG="--no-sandbox"

# GTK dialogs (file chooser) should not be scaled twice.
unset GDK_DPI_SCALE

# Widevine (Netflix/YouTube DRM). Chrome bundles its own CDM, so the external
# copy is only for Chromium builds that can load it — forcing Chrome onto a
# stale .so would break DRM. /usr/local/bin/chrome may be a symlink OR a
# wrapper script, so resolve both before deciding.
REAL_BIN=$(readlink -f "$browser" 2>/dev/null || echo "$browser")
if [ -f "$REAL_BIN" ] && grep -q '/opt/google/chrome' "$REAL_BIN" 2>/dev/null; then
    REAL_BIN=/opt/google/chrome/chrome
fi
WIDEVINE_FLAG=""
case "$REAL_BIN" in
    */google/chrome*|*google-chrome*) : ;;   # bundles its own CDM
    *)
        if [ -d /usr/lib64/chromium/WidevineCdm ]; then
            WV_VER=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' /usr/lib64/chromium/WidevineCdm/manifest.json 2>/dev/null)
            WIDEVINE_FLAG="--widevine-cdm-path=/usr/lib64/chromium/WidevineCdm/_platform_specific/linux_x64/libwidevinecdm.so --widevine-cdm-version=$WV_VER"
        fi
        ;;
esac

exec "$browser" $SANDBOX_FLAG $WIDEVINE_FLAG \
    --force-dark-mode --enable-features=WebUIDarkMode,WebContentsDarkMode \
    "$uri"
