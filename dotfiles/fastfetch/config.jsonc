// fastfetch config — Slackware edition
//
// Splash logo: bobdobbs.txt (plain-text ASCII art, painted bright white).
// The art file carries ANSI escapes (\e[97m ... \e[0m per line) because
// fastfetch 2.x ignores logo.color for file logos — colouring the art itself is
// the only way to force white regardless of the terminal's default foreground.
// logo.type must be "file" ("file-raw" also works but the ANSI escapes shift the
// aligned layout, and "ascii" is not a valid enum in fastfetch 2.x — it aborts
// the whole config).
// Mirrors the FreeBSD installer's fastfetch layout (colors, key width,
// separator, module ordering) with Slackware-specific values.

{
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/bobdobbs.txt",
        "padding": {
            "top": 0,
            "right": 2
        }
    },

    "display": {
        "separator": ": ",
        "color": {
            "keys": "light_white",
            "title": "light_white",
            "output": "white",
            "separator": "white"
        },
        // Percentages (Memory's "(13%)" and friends) and temperature values
        // default to green/yellow/red state colours. Pin every state to white so
        // no number on screen can ever come out green.
        "percent": {
            "color": { "green": "white", "yellow": "white", "red": "white" }
        },
        "temp": {
            "color": { "green": "white", "yellow": "white", "red": "white" }
        },
        "bar": {
            "color": { "elapsed": "white", "total": "white", "border": "white" }
        },
        "brightColor": true,
        "key": {
            "width": 20
        }
    },

    "modules": [
        // user@host in bold italics: the title module has no bold/italic setting,
        // so format overrides the output with indexed placeholders ({1} = user,
        // {2} = host; {user}/{hostname} are NOT substituted here) plus ANSI 1;3.
        { "type": "title", "fqdn": true, "format": "\u001b[1;3m{1}\u001b[0m@\u001b[1;3m{2}\u001b[0m" },
        { "type": "break" },
        { "type": "command", "key": "OS",            "text": "grep '^PRETTY_NAME=' /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '\"'" },
        { "type": "host",    "key": "Host" },
        { "type": "kernel",  "key": "Kernel" },
        { "type": "uptime",  "key": "Uptime" },
        { "type": "command", "key": "Packages",      "text": "echo \"pkg:$(ls /var/log/packages/ 2>/dev/null | wc -l | tr -d ' ') npm:$(npm list -g --depth=0 2>/dev/null | grep -c '@') pip:$(pip list 2>/dev/null | tail -n +3 | wc -l | tr -d ' ')\"" },
        { "type": "shell",   "key": "Shell" },
        { "type": "display", "key": "Resolution" },
        { "type": "de",      "key": "DE" },
        { "type": "wm",      "key": "WM" },
        { "type": "wmtheme", "key": "WM Theme" },
        { "type": "theme",   "key": "Theme" },
        { "type": "icons",   "key": "Icons" },
        { "type": "command", "key": "Terminal",      "text": "echo st" },
        { "type": "command", "key": "Font",          "text": "echo 'Berkeley Mono 28'" },
        { "type": "command", "key": "Browser",       "text": "browser-name" },
        { "type": "cpu",     "key": "CPU" },
        { "type": "gpu",     "key": "GPU" },
        { "type": "command", "key": "Disk",          "text": "df -h / 2>/dev/null | awk 'NR==2{printf \"%s / %s (%s)\",$3,$2,$5}'" },
        { "type": "memory",  "key": "Memory" },
        // Battery life: percentage + time-left estimate from the same rolling
        // discharge average `power` uses (upower history tail, live sysfs reading
        // folded in). `power _battery` prints nothing when there is no battery,
        // and fastfetch then drops the whole line — so this is harmless on a
        // desktop. It replaces one of the two blank lines before the colour bar.
        { "type": "command", "key": "Battery Life", "text": "power _battery 2>/dev/null" },
        { "type": "break" },
        { "type": "colors" }
    ]
}
